# ============ LLM（OpenAI 兼容接口） ============
# 推荐：智谱 GLM-4-Flash（免费、非推理模型、支持流式；已验证）
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
#
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# 不配置 LLM_API_KEY 时，服务端自动进入「离线演示模式」：
# 教学计划、提示、对话全部使用内置的确定性规则，演示不依赖网络。
#
# 注意：不要使用 glm-4.5-flash / glm-4.5-air 等“推理模型”——
# 它们的正文内容为空、思考在 reasoning_content 字段，本项目不兼容。

# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# 部分服务商不支持 response_format=json_object 时可关闭 JSON 模式：
# LLM_JSON_MODE=false

# ============ 服务端口 ============
# PORT=8787

# ============ Python 代码运行器解释器 ============
# PYTHON_BIN=python
